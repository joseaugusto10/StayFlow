@inherits LocalizedComponent

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <div class="empty-state">
                        <h2>@L["access.restricted"]</h2>
                        <p>@L["access.managersOnly"]</p>
                        <a class="btn" href="/">@L["access.back"]</a>
                    </div>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <div class="boot"><div class="spinner"></div></div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(AuthLayout)">
            <div class="empty-state">
                <h2>@L["notFound.title"]</h2>
                <a class="btn" href="/">@L["notFound.home"]</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
