@inherits LocalizedComponent

<div class="lang-switcher">
    @foreach (var language in I18n.Languages)
    {
        <button type="button" class="lang @(L.Culture == language.Culture ? "active" : "")"
                title="@language.Name" @onclick="() => L.SetCultureAsync(language.Culture)">
            <span>@language.Flag</span> @(Compact ? language.Culture[..2].ToUpperInvariant() : language.Name)
        </button>
    }
</div>

@code {
    [Parameter] public bool Compact { get; set; }
}
